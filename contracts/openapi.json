{
  "openapi": "3.1.0",
  "info": {
    "title": "Phase 1 onboarding proxy",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/onboarding/profile": {
      "post": {
        "summary": "Generate",
        "operationId": "generate_v1_onboarding_profile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answers": {
        "properties": {
          "userType": {
            "type": "string",
            "enum": [
              "student",
              "parent",
              "senior",
              "professional"
            ],
            "title": "Usertype"
          },
          "ageBand": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "under_18",
                  "18_29",
                  "30_44",
                  "45_59",
                  "60_plus"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Ageband"
          },
          "livingSituation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alone",
                  "with_family",
                  "with_others"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Livingsituation"
          },
          "employment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "studying",
                  "employed",
                  "self_employed",
                  "seeking_work",
                  "retired",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Employment"
          },
          "digitalConfidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Digitalconfidence"
          },
          "bankAppUsage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "one",
                  "multiple"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Bankappusage"
          },
          "activities": {
            "items": {
              "type": "string",
              "enum": [
                "online_banking",
                "online_shopping",
                "job_search",
                "loan_apps",
                "international_parcels",
                "online_bill_payments",
                "social_media"
              ]
            },
            "type": "array",
            "maxItems": 7,
            "title": "Activities"
          },
          "concerns": {
            "items": {
              "type": "string",
              "enum": [
                "digital_arrest",
                "kyc_bank",
                "courier_customs",
                "job_offer",
                "family_emergency",
                "loan_app",
                "sim_swap",
                "utility_disconnect"
              ]
            },
            "type": "array",
            "maxItems": 8,
            "title": "Concerns"
          },
          "priorScamExposure": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "prefer_not_to_say"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Priorscamexposure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "userType"
        ],
        "title": "Answers"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OnboardingRequest": {
        "properties": {
          "consent": {
            "type": "boolean",
            "const": true,
            "title": "Consent"
          },
          "answers": {
            "$ref": "#/components/schemas/Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "consent",
          "answers"
        ],
        "title": "OnboardingRequest"
      },
      "Profile": {
        "properties": {
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version"
          },
          "userType": {
            "type": "string",
            "enum": [
              "student",
              "parent",
              "senior",
              "professional"
            ],
            "title": "Usertype"
          },
          "threats": {
            "items": {
              "$ref": "#/components/schemas/Threat"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Threats"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "userType",
          "threats"
        ],
        "title": "Profile"
      },
      "Threat": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "digital_arrest",
              "kyc_bank",
              "courier_customs",
              "job_offer",
              "family_emergency",
              "loan_app",
              "sim_swap",
              "utility_disconnect"
            ],
            "title": "Type"
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level"
          },
          "why": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Why"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "level",
          "why"
        ],
        "title": "Threat"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
